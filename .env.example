BOT_TOKEN=your_bot_token
GUILD_ID=your_guild_id
CHANNEL_ID=your_primary_channel_id

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/group_memory_bot

# Retrieval strategy versions. Required at startup.
CHUNK_STRATEGY_VERSION=timegap-v1
SUMMARY_STRATEGY_VERSION=hourly-v1

# OpenAI models approved for the first bounded trial.
ANSWER_MODEL=gpt-5.4-mini
FALLBACK_MODEL=gpt-5.4-nano
ROUTER_MODEL=gpt-5.4-nano
SUMMARY_MODEL=gpt-5.4-nano
EMBEDDING_MODEL=text-embedding-3-small

# Prompt files. Contracts are documented in docs/design/runtime_flow.md.
ANSWER_SYSTEM_PROMPT_PATH=prompts/answer_system.md
ROUTER_PROMPT_PATH=prompts/router_should_retrieve.md

# Runtime timeouts
RAW_UPSERT_TIMEOUT_SECONDS=2
SESSION_DB_TIMEOUT_SECONDS=3
SESSION_TIMEOUT_MINUTES=15
ROUTER_TIMEOUT_SECONDS=3
QUERY_EMBEDDING_TIMEOUT_SECONDS=8
RETRIEVAL_DB_QUERY_TIMEOUT_SECONDS=3
ANSWER_TIMEOUT_SECONDS=45
FALLBACK_TIMEOUT_SECONDS=15

# Session context
SESSION_PROMPT_TURNS=8
SESSION_STORED_TURNS=20
ROUTER_SESSION_TURNS=4

# Retrieval limits
SUMMARY_TOP_K=3
ALIGNED_CHUNKS_PER_SUMMARY=2
ALIGNED_CHUNKS_MAX=6
GLOBAL_CHUNK_FALLBACK_TOP_K=2

# Prompt and output budgets
PROMPT_INPUT_TOKEN_BUDGET=12000
RAG_CONTEXT_BUDGET_RATIO=0.4
ANSWER_MAX_OUTPUT_TOKENS=1024
ROUTER_MAX_OUTPUT_TOKENS=128

# Retry limits
DISCORD_SEND_RETRY_COUNT=1
SESSION_UPDATE_RETRY_COUNT=1

# Batch chunking
CHUNK_WINDOW_MESSAGES=20
CHUNK_STRIDE_MESSAGES=10
MIN_CHUNK_MESSAGES=5
CHUNK_TEXT_MAX_CHARS=8000

# Batch summaries
MIN_SUMMARY_LLM_MESSAGES=5
SUMMARY_INPUT_TOKEN_BUDGET=6000
SUMMARY_MAX_OUTPUT_TOKENS=300
SUMMARY_FALLBACK_MAX_CHARS=4000

# Batch embeddings
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=3
SUMMARY_LLM_MAX_RETRIES=2

# Batch staging and retention
BATCH_STAGING_DIR=var/batches
BATCH_STAGING_RETENTION_DAYS=30

# Batch cost estimates. Leave empty to record cost as unknown.
# Bounded trial real-run gate. Dry-run estimated cost must be known and <= this value.
TRIAL_MAX_ESTIMATED_COST_USD=5.00
EMBEDDING_PRICE_PER_1M_TOKENS=
SUMMARY_INPUT_PRICE_PER_1M_TOKENS=
SUMMARY_OUTPUT_PRICE_PER_1M_TOKENS=
